{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace=server\" \"npm run dev --workspace=web\"",
    "format": "concurrently \"npm run format --workspace=server\" \"npm run format --workspace=web\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
